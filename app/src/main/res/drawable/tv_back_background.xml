<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <inset android:insetLeft="18px" android:insetRight="18px" android:insetTop="18px" android:insetBottom="18px"><shape>
            <solid android:color="?fourthBackgroundColor"/>
            <stroke android:width="2px" android:color="?colorAccent"/>
            <corners android:radius="18px"/>
        </shape></inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="18px" android:insetRight="18px" android:insetTop="18px" android:insetBottom="18px"><shape>
            <solid android:color="?colorControlHighlight"/>
            <corners android:radius="18px"/>
        </shape></inset>
    </item>
    <item android:drawable="@android:color/transparent"/>
</selector>
