<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application android:name="com.xx.blbl.AppController"
        android:label="@string/app_name" android:theme="@style/Theme.Blbl"
        android:banner="@mipmap/ic_launcher_tv" android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round" android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config" android:supportsRtl="false">
        <activity android:name="com.xx.blbl.ui.MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape" android:configChanges="keyboardHidden|orientation|screenSize"
            android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Blbl.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data android:name="com.xx.blbl.platform.ImageCachePolicy" android:value="GlideModule" />
    </application>
</manifest>
